# ============================================================================
# 一日一片 · OneADay 环境变量
# 复制为 .env 后按需修改。不填也能跑——默认走 mock provider。
# ============================================================================

# ---------------------------------------------------------------------------
# 模型：mock | ollama | openai
#   mock   : 内置模板基线，零网络零 key，clone 即跑（默认）
#   ollama : 本地模型，隐私最好
#   openai : 任何 OpenAI 兼容端点（DeepSeek / Qwen / Moonshot / OpenAI）
# ---------------------------------------------------------------------------
OAD_PROVIDER=mock

# ---------------------------------------------------------------------------
# Ollama（OAD_PROVIDER=ollama 时生效）
# ---------------------------------------------------------------------------
OAD_OLLAMA_BASE_URL=http://127.0.0.1:11434
OAD_OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# OpenAI 兼容（OAD_PROVIDER=openai 时生效）
# DeepSeek 示例：https://api.deepseek.com/v1  +  deepseek-chat
# 通义示例：    https://dashscope.aliyuncs.com/compatible-mode/v1  +  qwen-plus
# ---------------------------------------------------------------------------
OAD_OPENAI_BASE_URL=https://api.openai.com/v1
OAD_OPENAI_API_KEY=
OAD_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 采样参数（方案 08 定的默认值，偏「人味」，不适合事实问答）
# ---------------------------------------------------------------------------
OAD_TEMPERATURE=0.9
OAD_TOP_P=0.95
OAD_PRESENCE_PENALTY=0.6
OAD_TIMEOUT=60

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
OAD_PERSONA=brufen
OAD_DB_PATH=./data/oneadday.db
OAD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 每个 device 每分钟请求上限，0 表示不限
OAD_RATE_LIMIT=30

# 带进上下文的历史轮数
OAD_HISTORY_TURNS=8

# 前端反代目标（apps/web 用）
API_ORIGIN=http://127.0.0.1:8000
