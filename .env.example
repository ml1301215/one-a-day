# ============================================================================
# 一日一片 · OneADay 环境变量
# 复制为 .env 后按需修改。不填也能跑——默认走 mock provider。
# ============================================================================

# ---------------------------------------------------------------------------
# 模型：mock | deepseek | ollama | openai
#   mock     : 内置模板基线，零网络零 key，clone 即跑（默认）
#   deepseek : 官方 API，认准这一组变量，最省心的真模型
#   ollama   : 本地模型，隐私最好
#   openai   : 任何 OpenAI 兼容端点（Qwen / Moonshot / OpenAI）
# ---------------------------------------------------------------------------
OAD_PROVIDER=mock

# ---------------------------------------------------------------------------
# DeepSeek（OAD_PROVIDER=deepseek 时生效）
# key 申请：https://platform.deepseek.com/api_keys
# 注意：这个 key 等于账户余额，只写进 .env（已被 .gitignore 忽略），别提交
# ---------------------------------------------------------------------------
OAD_DEEPSEEK_BASE_URL=https://api.deepseek.com
OAD_DEEPSEEK_API_KEY=
OAD_DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Ollama（OAD_PROVIDER=ollama 时生效）
# ---------------------------------------------------------------------------
OAD_OLLAMA_BASE_URL=http://127.0.0.1:11434
OAD_OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# OpenAI 兼容（OAD_PROVIDER=openai 时生效）
# 通义示例：https://dashscope.aliyuncs.com/compatible-mode/v1  +  qwen-plus
# ---------------------------------------------------------------------------
OAD_OPENAI_BASE_URL=https://api.openai.com/v1
OAD_OPENAI_API_KEY=
OAD_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 采样参数（方案 08 定的默认值，偏「人味」，不适合事实问答）
# ---------------------------------------------------------------------------
OAD_TEMPERATURE=0.9
OAD_TOP_P=0.95
OAD_PRESENCE_PENALTY=0.6
OAD_TIMEOUT=60

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
OAD_PERSONA=brufen
OAD_DB_PATH=./data/oneadday.db
OAD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 每个 device 每分钟请求上限，0 表示不限
OAD_RATE_LIMIT=30

# 带进上下文的历史轮数
OAD_HISTORY_TURNS=8

# ---------------------------------------------------------------------------
# 生成链路（v4）
# ---------------------------------------------------------------------------

# 同轮生成几条候选，再按语料分布挑一条。1 = 关掉重排。
# 3 是默认值：三条候选刚好覆盖「常规 / 极短 / 不自述」三种形状。
# 代价是 token 三倍——想省钱就设 1，想更像人就别低于 3。
OAD_CANDIDATES=3

# 质量闸门：
#   format —— 只拦 emoji / Markdown / 分点列表 / 空回复 / 助手腔 / 照抄示例（默认）
#   strict —— 任何风格问题都触发重写（v2 行为，留着做 A/B）
OAD_STYLE_GATE=format

# 安全分级姿态：
#   off   —— 不在主链路上分级、不给模板、不缩放幽默系数（默认）
#            重话怎么接写在人格包的 seriousness 一节里，由性格承接
#   guard —— v3 的 L0–L3 硬闸 + 写死模板 + 越界拒绝表
#            需要合规部署、或想做 A/B 对照时打开
OAD_SAFETY=off

# 语料纹理路径。默认读 packages/persona/<OAD_PERSONA>/texture.json，
# 由 `python tools/distill/run.py --all` 生成。文件缺失时会回落到
# 人格包里的手写标尺（不报错，只是「像不像」少了数据支撑）。
# OAD_TEXTURE=../packages/persona/brufen/texture.json

# 前端反代目标（apps/web 用）
API_ORIGIN=http://127.0.0.1:8000
